{
  "name": "chat",
  "version": "1.0.0",
  "description": "간단한 사람 간 채팅방 (Express + MariaDB, Vercel 배포)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "db:init": "node scripts/init-db.js",
    "db:init:cloud": "node -r dotenv/config scripts/init-db.js dotenv_config_path=.env.cloud",
    "db:check": "node scripts/check-db.js",
    "db:check:cloud": "node -r dotenv/config scripts/check-db.js dotenv_config_path=.env.cloud"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  }
}
