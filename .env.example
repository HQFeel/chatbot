# 로컬 MariaDB 기준 예시. Vercel에서는 같은 이름의 환경변수를 클라우드 DB 값으로 설정한다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat
# 클라우드 DB(TLS 필수)를 쓸 때 true
DB_SSL=false
PORT=3000
# 로그인 쿠키 서명용 비밀값(32자 이상). 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
